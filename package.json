{
  "name": "logitrack-express",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "capture": "node scripts/capture.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "8.8.21",
    "ionicons": "^8.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.31",
    "@angular/cli": "21.2.31",
    "@angular/compiler-cli": "21.2.26",
    "@angular/language-service": "21.2.26",
    "@capacitor/cli": "8.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ionic/angular-toolkit": "^12.3.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "21.4.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.12"
  },
  "prettier": "@ionic/prettier-config",
  "description": "An Ionic project",
  "engines": {
    "node": "24.21.0"
  }
}
